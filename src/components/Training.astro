---
import { Image } from 'astro:assets';
import video1 from '../assets/videos/curso-1.mp4';
import video2 from '../assets/videos/curso-2.mp4';
import video3 from '../assets/videos/curso-3.mp4';

const videos = [
  { id: 1, url: video1, title: 'Técnicas Avançadas' },
  { id: 2, url: video2, title: 'Barboterapia' },
  { id: 3, url: video3, title: 'Gestão de Barbearia' }
];
---

<section id="treinamentos" class="py-24 bg-primary relative border-t border-border/30" x-data="{ activeVideo: null, modalOpen: false, openModal(url) { this.activeVideo = url; this.modalOpen = true; }, closeModal() { this.modalOpen = false; this.activeVideo = null; } }">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-16 gsap-reveal">
      <p class="text-accent uppercase tracking-widest font-semibold text-sm mb-2">Especialização</p>
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">
        Curso Barbeiro <span class="text-accent italic">de Elite</span>
      </h2>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto font-light">
        Aprenda as técnicas exclusivas e a gestão que transformam barbeiros comuns em referências no mercado.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      {videos.map((vid, index) => (
        <div 
          class="relative group aspect-[4/5] rounded-sm overflow-hidden cursor-pointer gsap-reveal bg-secondary" 
          style={`transition-delay: ${index * 150}ms`}
          @click={`openModal('${vid.url}')`}
        >
          <video 
            src={vid.url} 
            autoplay 
            loop 
            muted 
            playsinline 
            class="w-full h-full object-cover grayscale opacity-70 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700 transform group-hover:scale-105"
          ></video>
          
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent flex flex-col justify-end p-6 pointer-events-none">
            <h3 class="text-white font-heading text-2xl font-bold mb-2">{vid.title}</h3>
            <div class="flex items-center text-accent">
              <svg class="w-6 h-6 mr-2 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <span class="text-sm font-semibold uppercase tracking-wider">Assistir Vídeo</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="flex flex-col sm:flex-row justify-center items-center gap-6 gsap-reveal">
      <a href="https://wa.me/5547920026069?text=Quero%20saber%20mais%20sobre%20o%20Curso%20Barbeiro%20de%20Elite" 
         target="_blank" rel="noopener noreferrer" 
         class="btn-primary w-full sm:w-auto">
        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.347-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.876 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        Falar sobre o curso
      </a>
      <a href="https://instagram.com/lems_barber" target="_blank" rel="noopener noreferrer" 
         class="btn-outline w-full sm:w-auto">
        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        Siga para mais Dicas
      </a>
    </div>

    <!-- Video Modal -->
    <template x-teleport="body">
      <div 
        x-show="modalOpen" 
        style="display: none;"
        class="fixed inset-0 z-[100] flex items-center justify-center bg-black/95 backdrop-blur-sm p-4"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        @keydown.escape.window="closeModal()"
      >
        <button 
          @click="closeModal()" 
          class="absolute top-6 right-6 text-white/70 hover:text-white transition-colors"
        >
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
        
        <div 
          class="w-full max-w-5xl aspect-[9/16] md:aspect-video bg-black rounded-lg overflow-hidden shadow-2xl relative"
          x-transition:enter="transition ease-out duration-300 delay-100"
          x-transition:enter-start="opacity-0 scale-95"
          x-transition:enter-end="opacity-100 scale-100"
          @click.stop
        >
          <template x-if="modalOpen">
            <video 
              :src="activeVideo" 
              controls 
              autoplay
              class="w-full h-full object-contain"
            ></video>
          </template>
        </div>
      </div>
    </template>
    
  </div>
</section>
