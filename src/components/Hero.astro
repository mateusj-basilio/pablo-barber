---
import { Image } from 'astro:assets';
import bannerImg from '../assets/images/banner/banner.png';
---

<section class="relative min-h-screen flex items-center bg-primary overflow-hidden pt-12 lg:pt-0">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full h-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-8 items-center min-h-[calc(100vh-5rem)]">
      
      <!-- Text Content (Left) -->
      <div class="relative z-10 flex flex-col justify-center order-2 lg:order-1 pb-16 lg:pb-0 text-center lg:text-left items-center lg:items-start mt-8 lg:mt-0">
        <p class="text-accent uppercase tracking-[0.2em] font-semibold text-sm mb-6 flex items-center justify-center lg:justify-start gap-4">
          <span class="w-12 h-[1px] bg-accent hidden lg:block"></span>
          Barbeiro de Alto Padrão
        </p>
        
        <h1 class="font-heading text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-bold text-white leading-[1.1] mb-8">
          A Arte do <br /> <span class="text-accent italic font-light">Corte</span> Clássico
        </h1>
        
        <p class="text-text-secondary text-lg sm:text-xl max-w-lg mb-12 font-light leading-relaxed mx-auto lg:mx-0">
          Cortes precisos, visagismo e barboterapia clássica para o homem que exige o melhor. Viva a verdadeira experiência premium em Imbuia, no coração do Alto Vale - SC.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-6 items-center sm:items-center w-full sm:w-auto">
          <a href="https://cashbarber.com.br/dj" target="_blank" rel="noopener noreferrer" class="btn-primary w-full sm:w-auto">
            Agendar Horário
          </a>
          <a href="#sobre" class="btn-outline w-full sm:w-auto">
            Minha Trajetória
          </a>
        </div>
      </div>

      <!-- Image Content (Right) -->
      <div class="relative w-full h-[55vh] lg:h-screen order-1 lg:order-2 flex items-center justify-end mt-4 lg:mt-0">
        <!-- Gradients para suavizar as bordas da imagem -->
        <div class="absolute inset-0 bg-gradient-to-r from-primary via-transparent to-transparent z-10 hidden lg:block"></div>
        <div class="absolute inset-0 bg-gradient-to-l from-primary via-transparent to-transparent z-10 hidden lg:block w-32 right-0 left-auto"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-primary via-transparent to-transparent z-10 lg:hidden h-1/2 bottom-0 top-auto"></div>
        <Image 
          src={bannerImg} 
          alt="Pablo Lems" 
          class="w-full h-full object-cover object-[50%_15%] lg:object-top lg:absolute lg:inset-y-0 lg:right-0 lg:w-[55vw] grayscale contrast-125"
        />
      </div>
      
    </div>
  </div>
</section>
