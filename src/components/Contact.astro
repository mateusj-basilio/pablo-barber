---
// src/components/Contact.astro
---

<section id="contato" class="py-24 bg-primary relative border-t border-border/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      
      <div class="gsap-reveal">
        <h2 class="font-heading text-4xl md:text-5xl font-bold mb-6 text-white">
          Entre em <span class="text-accent italic">Contato</span>
        </h2>
        <p class="text-text-secondary text-lg font-light mb-10">
          Agende seu horário ou tire dúvidas. Estamos localizados no coração de Imbuia.
        </p>
        
        <div class="space-y-8">
          <div class="flex items-start gap-4">
            <div class="text-accent mt-1">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
              <h4 class="text-white font-bold mb-1">Endereço</h4>
              <p class="text-text-secondary font-light">R. Avelino Ludwig, 310 - Centro<br/>Imbuia - SC, 88440-000</p>
            </div>
          </div>
          
          <div class="flex items-start gap-4">
            <div class="text-accent mt-1">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div>
              <h4 class="text-white font-bold mb-1">Horário de Funcionamento</h4>
              <p class="text-text-secondary font-light leading-relaxed">
                Domingo a Sexta: 08:30 – 19:30<br/>
                Sábado: 08:00 – 12:30
              </p>
            </div>
          </div>
          
          <div class="flex items-start gap-4">
            <div class="text-accent mt-1">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <div>
              <h4 class="text-white font-bold mb-1">Contato</h4>
              <p class="text-text-secondary font-light">
                Telefone: (47) 98432-4907<br/>
                WhatsApp: (47) 92002-6069
              </p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="gsap-reveal" style="transition-delay: 200ms;">
        <div class="bg-secondary p-2 rounded-sm border border-border h-full min-h-[400px]">
          <!-- Placeholder map for Imbuia, SC -->
          <iframe 
            src="https://maps.google.com/maps?q=R.+Avelino+Ludwig,+310+-+Centro,+Imbuia+-+SC,+88440-000&t=&z=16&ie=UTF8&iwloc=&output=embed" 
            width="100%" 
            height="100%" 
            style="border:0; filter: grayscale(100%) invert(90%) contrast(1.2);" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            class="rounded-sm"
          ></iframe>
        </div>
      </div>
      
    </div>
    
  </div>
</section>
