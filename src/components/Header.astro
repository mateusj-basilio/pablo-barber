---
// src/components/Header.astro
---

<header 
  class="fixed w-full top-0 z-50 bg-primary/95 backdrop-blur-md border-b border-border transition-all duration-300"
  x-data="{ mobileMenuOpen: false, scrolled: false }"
  @scroll.window="scrolled = (window.pageYOffset > 20)"
  :class="{'py-2 shadow-md': scrolled, 'py-4': !scrolled}"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center">
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a href="#" class="font-heading text-2xl font-bold tracking-wider text-accent">
          PABLO LEMS<span class="text-text-primary text-sm font-sans tracking-normal ml-2 opacity-70 hidden sm:inline">BARBER</span>
        </a>
      </div>
      
      <!-- Desktop Menu -->
      <nav class="hidden md:flex space-x-8 items-center">
        <a href="#sobre" class="text-sm font-medium text-text-primary hover:text-accent transition-colors">Sobre</a>
        <a href="#especialidades" class="text-sm font-medium text-text-primary hover:text-accent transition-colors">Especialidades</a>
        <a href="#galeria" class="text-sm font-medium text-text-primary hover:text-accent transition-colors">Galeria</a>
        <a href="#contato" class="text-sm font-medium text-text-primary hover:text-accent transition-colors">Contato</a>
        
        <a href="https://cashbarber.com.br/dj" target="_blank" rel="noopener noreferrer" 
           class="btn-primary py-2 px-6">
          Agendar Horário
        </a>
      </nav>

      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center">
        <button @click="mobileMenuOpen = !mobileMenuOpen" type="button" class="text-text-primary hover:text-accent focus:outline-none p-2" aria-controls="mobile-menu" aria-expanded="false">
          <span class="sr-only">Abrir menu</span>
          <svg class="h-6 w-6" x-show="!mobileMenuOpen" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="h-6 w-6" x-show="mobileMenuOpen" style="display: none;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div x-show="mobileMenuOpen" 
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0 -translate-y-2"
       x-transition:enter-end="opacity-100 translate-y-0"
       x-transition:leave="transition ease-in duration-150"
       x-transition:leave-start="opacity-100 translate-y-0"
       x-transition:leave-end="opacity-0 -translate-y-2"
       class="md:hidden bg-secondary border-b border-border absolute w-full" 
       id="mobile-menu" 
       style="display: none;">
    <div class="px-2 pt-2 pb-6 space-y-1 sm:px-3 flex flex-col gap-2">
      <a href="#sobre" @click="mobileMenuOpen = false" class="block px-3 py-2 rounded-md text-base font-medium text-text-primary hover:text-accent hover:bg-primary/50 transition-colors">Sobre</a>
      <a href="#especialidades" @click="mobileMenuOpen = false" class="block px-3 py-2 rounded-md text-base font-medium text-text-primary hover:text-accent hover:bg-primary/50 transition-colors">Especialidades</a>
      <a href="#galeria" @click="mobileMenuOpen = false" class="block px-3 py-2 rounded-md text-base font-medium text-text-primary hover:text-accent hover:bg-primary/50 transition-colors">Galeria</a>
      <a href="#contato" @click="mobileMenuOpen = false" class="block px-3 py-2 rounded-md text-base font-medium text-text-primary hover:text-accent hover:bg-primary/50 transition-colors">Contato</a>
      <a href="https://cashbarber.com.br/dj" @click="mobileMenuOpen = false" class="mt-4 btn-primary w-full">
        Agendar Horário
      </a>
    </div>
  </div>
</header>
