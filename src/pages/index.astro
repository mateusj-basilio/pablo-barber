---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Qualifications from '../components/Qualifications.astro';
import Philosophy from '../components/Philosophy.astro';
import Training from '../components/Training.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Instagram from '../components/Instagram.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
---

<Layout 
  title="Pablo Lems | Barbeiro de Elite em Imbuia e Região" 
  description="Pablo Lems é especialista em corte clássico e visagismo. Atendendo em Imbuia, SC e clientes de Ituporanga, Rio do Sul, Vidal Ramos e região. Agende seu horário."
>
  <Header />
  
  <main>
    <Hero />
    <About />
    <Qualifications />
    <Philosophy />
    <Training />
    <Services />
    <Gallery />
    <Testimonials />
    <FAQ />
    <Instagram />
    <Contact />
  </main>
  
  <Footer />
  <FloatingWhatsApp />
</Layout>
